# ─────────────────────────────────────────────────────────────────────────────
# Log360 Dev Suite — Environment Variables
# Copy this file to .env and fill in the values before starting the app.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Zoho OAuth client ID
# Create an OAuth client at https://api-console.zoho.com/
# Client type: "Server-based Applications" or "Non-based Applications (Implicit)"
# Add redirect URI: https://<your-catalyst-app>.catalystappsail.com/authentication/callback
REACT_APP_ZOHO_CLIENT_ID=your_zoho_client_id_here

# OAuth redirect URI (must exactly match one of the URIs registered in Zoho API Console)
# For local development: http://localhost:3000/authentication/callback
# For production (Zoho Catalyst): https://<app-id>.catalystappsail.com/authentication/callback
REACT_APP_ZOHO_REDIRECT_URI=http://localhost:3000/authentication/callback

# Comma-separated list of Zoho email addresses allowed to access Log360 Dev Suite.
# These should be the members of wsm-info@zohocorp.com.
# If left empty, any authenticated @zohocorp.com user will be allowed.
# Example: john.doe@zohocorp.com,jane.smith@zohocorp.com
REACT_APP_ALLOWED_EMAILS=
