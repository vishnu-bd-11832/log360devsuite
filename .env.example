# ─────────────────────────────────────────────────────────────────────────────
# Log360 Dev Suite — Environment Variables
# Data Centre: Indian DC (Zoho IN)
# Copy this file to .env and fill in the values before starting the app.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Zoho OAuth client ID  (Indian DC)
# Create an OAuth client at https://api-console.zoho.in/
# Client type: "Non-based Applications" (implicit grant, SPA-safe)
# Add redirect URI: https://<project-id>-<env-id>.catalystappsail.in/authentication/callback
REACT_APP_ZOHO_CLIENT_ID=your_zoho_client_id_here

# OAuth redirect URI — must exactly match the URI registered in Zoho API Console (IN)
# For local development:   http://localhost:3000/authentication/callback
# For Catalyst (IN DC):    https://<project-id>-<env-id>.catalystappsail.in/authentication/callback
REACT_APP_ZOHO_REDIRECT_URI=http://localhost:3000/authentication/callback

# Comma-separated list of Zoho email addresses allowed to access Log360 Dev Suite.
# Populate with the current roster of wsm-info@zohocorp.com members.
# If left empty, any authenticated @zohocorp.com user will be granted access.
# Example: john.doe@zohocorp.com,jane.smith@zohocorp.com
REACT_APP_ALLOWED_EMAILS=

# Catalyst API base URL for the log360-api cloud function (set at deploy time)
# Example: https://<project-id>-<env-id>.catalystappsail.in/api
REACT_APP_CATALYST_API_URL=http://localhost:3001/api
